<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- APKbox is a local package-revision manager, so package visibility is core functionality. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Optional, user-granted bridge presentation mode for true always-on-top ChatGPT messages. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Optional direct-storage access powers APKbox's own APK-focused file browser and Auto Scanner. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- Remote Debug Bridge: private GitHub relay + same-device privileged transports. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!--
      Development permission that APKbox can self-grant once through an already-authorized
      Shizuku/Sui or Wireless ADB session. APKbox uses it only to write the official
      Settings.Global adb_wifi_enabled flag, allowing future Wireless Debugging self-start without
      requiring an already-live privileged transport. Android still enforces Wi-Fi/trusted-network
      policy and the existing ADB pairing identity.
    -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />

    <application
        android:name=".ApkBoxApplication"
        android:allowBackup="false"
        android:icon="@drawable/ic_app_icon"
        android:label="APKbox"
        android:supportsRtl="true"
        android:theme="@style/Theme.APKbox">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="unspecified">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Share one or many APKs directly into APKbox from Downloads, Files, chat apps, etc. -->
            <intent-filter android:label="Add to APKbox">
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.android.package-archive" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <!--
          Existing generic package-manager-style path. Keep this exactly as the catch-all APKbox
          chooser so users can still choose Install / Unattended / Uninstall & reinstall inside the
          APKbox screen after selecting one resolver entry.
        -->
        <activity
            android:name=".OpenApkInstallerActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:screenOrientation="unspecified">
            <intent-filter android:label="Archive &amp; install with APKbox" android:priority="1">
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.INSTALL_PACKAGE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/vnd.android.package-archive" />
            </intent-filter>

            <!-- Some third-party file managers expose APKs as generic binary content. -->
            <intent-filter android:label="Archive &amp; install with APKbox">
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.INSTALL_PACKAGE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <!--
          Direct resolver choices. Distinct Activity components are intentional: Android can collapse
          multiple matching intent-filters on one Activity into one resolver row. These tiny routers
          preserve the incoming URI/grants and open the same APKbox installer with a fixed mode.
        -->
        <activity
            android:name=".OpenApkInstallRouterActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:label="APKbox · Install">
            <intent-filter android:label="Install with APKbox" android:priority="2">
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.INSTALL_PACKAGE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/vnd.android.package-archive" />
            </intent-filter>
            <intent-filter android:label="Install with APKbox" android:priority="2">
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.INSTALL_PACKAGE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <activity
            android:name=".OpenApkUnattendedRouterActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:label="APKbox · Unattended">
            <intent-filter android:label="Unattended install with APKbox" android:priority="2">
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.INSTALL_PACKAGE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/vnd.android.package-archive" />
            </intent-filter>
            <intent-filter android:label="Unattended install with APKbox" android:priority="2">
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.INSTALL_PACKAGE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <activity
            android:name=".OpenApkReinstallRouterActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:label="APKbox · Uninstall &amp; reinstall">
            <intent-filter android:label="Uninstall &amp; reinstall with Package Installer" android:priority="2">
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.INSTALL_PACKAGE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/vnd.android.package-archive" />
            </intent-filter>
            <intent-filter android:label="Uninstall &amp; reinstall with Package Installer" android:priority="2">
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.INSTALL_PACKAGE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <!-- Internal user-facing silent install flow backed by Shizuku/Sui or Wireless ADB. -->
        <activity
            android:name=".UnattendedInstallActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:screenOrientation="unspecified" />

        <activity
            android:name=".AutoScanActivity"
            android:exported="false"
            android:screenOrientation="unspecified" />

        <activity
            android:name=".bridge.BridgeActivity"
            android:exported="false"
            android:screenOrientation="unspecified" />
        <activity
            android:name=".bridge.BridgeApprovalActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:screenOrientation="unspecified" />

        <!--
          Display-only and intentionally exported so a privileged shell transport can surface an
          informational ChatGPT popup despite Android background-activity restrictions. It cannot
          execute commands or alter bridge approval state; it only renders message data already
          stored inside APKbox's private app storage.
        -->
        <activity
            android:name=".bridge.BridgeMessageActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:screenOrientation="unspecified" />

        <!-- Local UI only; configures notification, popup-activity, and overlay message modes. -->
        <activity
            android:name=".bridge.BridgeMessageDisplaySettingsActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:screenOrientation="unspecified" />

        <service
            android:name=".bridge.RemoteBridgeService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-enabled ChatGPT remote debugging relay using Shizuku, Sui, or same-device Wireless ADB" />
        </service>

        <!--
          Optional one-shot Wireless ADB bootstrap helper. Android Settings is the only package the
          service can inspect; BIND_ACCESSIBILITY_SERVICE prevents arbitrary apps from binding it.
          The service disables itself immediately after APKbox pairs successfully.
        -->
        <service
            android:name=".bridge.PairingAssistantService"
            android:exported="true"
            android:label="APKbox Pairing Assistant"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/pairing_assistant_service" />
        </service>

        <!-- Official Shizuku/Sui Binder delivery endpoint. Sui is initialized automatically. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <receiver
            android:name=".install.InstallResultReceiver"
            android:exported="false" />

        <!-- DownloadManager completion can wake APKbox even when its UI is not running. -->
        <receiver
            android:name=".AutoScanDownloadReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.DOWNLOAD_COMPLETE" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".bridge.BridgeBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
